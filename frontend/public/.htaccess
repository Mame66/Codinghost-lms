# IONOS / Apache : toutes les URL de l'application (ex : /groups/2, /login/enfants)
# renvoient index.html, sinon un rafraîchissement de page donne une erreur 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
